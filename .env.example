# Database
DATABASE_URL=sqlite+aiosqlite:///./document_identifier.db

# Local LLM (Ollama) — all document processing is in-process, no data leaves the server
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
LOCAL_TRAINING_DIR=data/training

# Classification
CONFIDENCE_THRESHOLD=0.6
XLSX_RULE_THRESHOLD=0.5

# App
MAX_UPLOAD_BYTES=20971520
DEBUG=false
